# Copy to .env on the server and fill in. docker compose reads it automatically.

# ── Telegram ────────────────────────────────────────────────────────────────
# Create a bot by messaging @BotFather on Telegram: /newbot
# It replies with a token like 8123456789:AAH... — paste it here.
TELEGRAM_BOT_TOKEN=
# The bot's @name without the @. Optional: the app asks Telegram for it at
# startup, but setting it here makes deep links work on the very first request.
TELEGRAM_BOT_USERNAME=

# ── App ─────────────────────────────────────────────────────────────────────
PUBLIC_URL=https://rally.ospi.link
CRAWL_INTERVAL_MINUTES=60

# Guards POST /api/crawl so a public page cannot trigger crawls of Roadsurfer.
# Generate with: openssl rand -hex 24
ADMIN_TOKEN=
